# Copy to DEPLOY_ROOT/production.env on the server; chmod 600.
# This file stays on the server. Do not commit real values or upload it as an artifact.
PUBLIC_URL=https://detour.bmstack.net/
PUBLIC_HOST=detour.bmstack.net
OWNER_EMAIL=replace-with-your-google-email
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
CHATGPT_CLIENT_ID=detour-chatgpt
CHATGPT_REDIRECT_URI=replace-with-exact-chatgpt-oauth-callback
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
SIGNING_CERTIFICATE_PASSWORD=replace-with-signing-pfx-password
ENCRYPTION_CERTIFICATE_PASSWORD=replace-with-encryption-pfx-password
AUTH_CERTIFICATES_DIR=/srv/detour/certificates
AUTH_KEYS_DIR=/srv/detour/keys
# Example only: check for subnet conflicts on your server before using these.
APP_NETWORK_SUBNET=172.30.50.0/24
APP_NETWORK_GATEWAY=172.30.50.1
WEB_PROXY_IP=172.30.50.254
